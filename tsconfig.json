{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "allowJs": false,
    "noEmit": true
  },
  "include": ["server/**/*.ts", "api/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
